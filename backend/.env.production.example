# ===========================================
# AuraSpot Backend Production Environment
# ===========================================
# Set these in Vercel Dashboard > Project Settings > Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Connection (use MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/auraspot

# AI Service (OpenRouter - DeepSeek)
DEEPSEEK_API_KEY=your_openrouter_api_key
DEEPSEEK_MODEL=tngtech/deepseek-r1t2-chimera:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# CORS Configuration (your deployed frontend URL)
CORS_ORIGINS=https://your-frontend.vercel.app

# Firebase (used to verify user ID tokens on every authenticated request)
# Same value as VITE_FIREBASE_PROJECT_ID in the frontend
FIREBASE_PROJECT_ID=your_firebase_project_id
# Optional: full service-account JSON on one line (not required for token verification)
# FIREBASE_SERVICE_ACCOUNT=

# Shared secret for the /rent/process-reminders cron endpoint (Vercel sends it automatically)
CRON_SECRET=generate_a_long_random_string
